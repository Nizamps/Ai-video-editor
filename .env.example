# GEMINI_API_KEY: Server-side AI key automatically injected by AI Studio at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional server-side OpenAI API key for external deployment.
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# VITE_API_BASE_URL: Optional external backend URL when frontend is hosted on GitHub Pages.
VITE_API_BASE_URL=""
